<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Expense Tracker Backup Rules

      ✅ Goal:
      - Backup only non-sensitive configuration (e.g., safe user preferences)
      - Exclude all user-sensitive or financial data
      - Improve user privacy & comply with data regulations (e.g., GDPR, CCPA)

      ✏ How:
      - Only include specific files you trust to backup
      - Avoid including full databases or all shared preferences
    -->

    <!-- ✅ Include only safe shared preferences -->
    <include domain="sharedpref" path="app_preferences.xml" />

    <!-- ✅ Include files directory (by default) -->
    <include domain="file" path="." />

    <!-- ❌ Exclude sensitive folder inside files (e.g., generated financial reports) -->
    <exclude domain="file" path="financial_reports/" />

    <!--
      ⚠ Note:
      - We do NOT include the database domain → so no databases are backed up.
      - We do NOT include all shared preferences → so sensitive prefs (e.g., login tokens) aren't backed up.
      - We also skip cache by not including domain="root" or external files.
    -->
</full-backup-content>
