<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Expense Tracker Backup Rules
      We include the database so users don't lose their records on device upgrade.
    -->
    <include domain="database" path="expense_tracker_db" />
    <include domain="sharedpref" path="app_preferences.xml" />
    <include domain="file" path="." />

    <!-- Exclude temp and cache files -->
    <exclude domain="file" path="financial_reports/" />
</full-backup-content>
