<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include domains first -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <!-- Exclude sensitive or non-essential items -->
        <exclude domain="file" path="financial_reports/"/>
        <exclude domain="sharedpref" path="user_session.xml"/>
        <exclude domain="sharedpref" path="authentication_tokens.xml"/>
    </cloud-backup>

    <device-transfer>
        <!-- Include domains first -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <!-- Exclude highly sensitive items -->
        <exclude domain="sharedpref" path="authentication_tokens.xml"/>
    </device-transfer>
</data-extraction-rules>
